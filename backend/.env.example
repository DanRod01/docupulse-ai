# Backend App Settings
PROJECT_NAME="DocuPulse AI"
API_V1_STR="/api/v1"

# CORS (comma-separated or JSON list if needed)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Google AI Studio API Key (Gemini)
GEMINI_API_KEY="sua_gemini_api_key_aqui"

# PostgreSQL with pgvector (Supabase connection string)
# Exemplo: postgresql://postgres:[SUA_SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/docupulse"
