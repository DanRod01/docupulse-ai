# Backend App Settings
PROJECT_NAME="DocuPulse AI"
API_V1_STR="/api/v1"

# CORS (origens autorizadas do frontend)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Google AI Studio API Key (Gemini)
# Obtenha gratuitamente em: https://aistudio.google.com
GEMINI_API_KEY="sua_gemini_api_key_aqui"
GEMINI_MODEL_NAME="gemini-3.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# PostgreSQL com extensão pgvector (Supabase ou PostgreSQL Local)
# Formato: postgresql://postgres:[SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/docupulse"

# Chave de segurança para endpoints da API (opcional em dev, recomendada em prod)
API_KEY="docupulse-dev-secret-2024"

# Limite máximo de upload de arquivo em MB
MAX_UPLOAD_SIZE_MB=20
